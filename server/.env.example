# --- DATABASE CONFIGURATION ---
# These must match the values used in your local Docker setup
POSTGRES_DB=mapetite_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password_here

# --- DJANGO SETTINGS ---
# Generate a fresh key for local dev: https://djecrety.ir/
DJANGO_SECRET_KEY=your-repo-placeholder-key
DJANGO_DEBUG=True

# --- SERVER NETWORKING ---
# Use 'localhost' for native dev, or 'database' if running Django inside Docker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- SMTP EMAIL CONFIGURATION ---
# Required for password reset emails and other notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- GEMINI API CONFIGURATION ---
# Required for Gemini features
GOOGLE_API_KEY=your-gemini-api-key-here